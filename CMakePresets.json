{
	"version": 3,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/out/build/${presetName}",
			"installDir": "${sourceDir}/out/install/${presetName}"
		},
		{
			"name": "x64-Debug",
			"displayName": "x64 Debug",
			"inherits": "base",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug"
			}
		},
		{
			"name": "x64-Release",
			"displayName": "x64 Release",
			"inherits": "base",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo"
			}
		},
		{
			"name": "arm64-Debug",
			"displayName": "ARM64 Debug",
			"inherits": "base",
			"architecture": {
				"value": "arm64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"USE_GLES": {
					"type": "BOOL",
					"value": "True"
				}
			}
		},
		{
			"name": "arm64-Release",
			"displayName": "ARM64 Release",
			"inherits": "base",
			"architecture": {
				"value": "arm64",
				"strategy": "external"
			},
			"toolset": {
				"value": "host=x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"USE_GLES": {
					"type": "BOOL",
					"value": "True"
				}
			}
		}
	]
}